{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "schedule": ["before 9am on monday"],
  "minimumReleaseAge": "10 days",
  "packageRules": [
    {
      "description": "Group all updates into a single PR",
      "matchPackageNames": ["*"],
      "groupName": "all dependencies",
      "groupSlug": "all"
    },
    {
      "description": "Only move Node.js to even (LTS-track) major versions",
      "matchDepNames": ["node"],
      "allowedVersions": "/^\\d*[02468](\\.|$)/"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update ARG versions in Dockerfile from GitHub releases",
      "managerFilePatterns": ["/(^|/)Dockerfile$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-]+?) depName=(?<depName>.+?)\\n(?:ENV|ARG) .+?_VERSION=(?<currentValue>.+?)\\n"
      ],
      "extractVersionTemplate": "^v?(?<version>.+)$"
    },
    {
      "customType": "regex",
      "description": "Update the hadolint image run inside the build workflow",
      "managerFilePatterns": ["/^\\.github/workflows/build\\.yml$/"],
      "matchStrings": [
        "(?<depName>hadolint/hadolint):(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[a-f0-9]+)"
      ],
      "datasourceTemplate": "docker"
    }
  ]
}
